# ==============================================================================
# VideoFetch - Configuração de Variáveis de Ambiente
# ==============================================================================

# Porta do Servidor
PORT=3000

# URL pública da aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Redis para fila BullMQ (Opcional no dev: se vazio, o sistema usa MemoryQueue assíncrona automaticamente)
REDIS_URL=redis://localhost:6379

# Concorrência de processamento de downloads simultâneos
QUEUE_CONCURRENCY=2

# Diretório para armazenamento temporário de vídeos
TEMP_STORAGE_DIR=

# Caminhos para binários (opcional se já instalados no PATH do sistema)
YT_DLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
